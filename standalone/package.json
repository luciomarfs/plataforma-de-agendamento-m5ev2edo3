{
  "name": "plataforma-agendamento-standalone",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo standalone para deploy em VM Linux (SaveinCloud) com PostgreSQL, Knex e React frontends",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "migrate": "npm run --workspace=apps/api migrate",
    "migrate:rollback": "npm run --workspace=apps/api migrate:rollback",
    "seed": "npm run --workspace=apps/api seed",
    "start:api": "npm run --workspace=apps/api start",
    "dev:api": "npm run --workspace=apps/api dev",
    "dev:empresa": "npm run --workspace=apps/web-empresa dev",
    "dev:usuario": "npm run --workspace=apps/web-usuario dev"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
