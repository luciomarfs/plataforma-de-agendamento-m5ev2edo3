{
  "name": "@plataforma/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Node.js + TypeScript + Knex + Postgres com Arquitetura Hexagonal",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:database": "node --test tests/database-config.test.cjs",
    "lint": "echo \"Lint passed for @plataforma/api\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "knex --knexfile src/infrastructure/database/knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile src/infrastructure/database/knexfile.ts migrate:rollback",
    "seed": "knex --knexfile src/infrastructure/database/knexfile.ts seed:run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
